# Node
TZ=UTC
PORT=3330
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# CORS — comma-separated exact origins allowed for credentialed cross-origin requests
# (admin panel, business dashboard). Required in production for cookie-based login to work.
# Example: CORS_ALLOWED_ORIGINS=https://admin.tumaplus.com,https://app.tumaplus.com
CORS_ALLOWED_ORIGINS=

#--------------------------------------------------------------------
# Database (PostgreSQL)
#--------------------------------------------------------------------
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=

#--------------------------------------------------------------------
# Redis (BullMQ queue backend)
#--------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

#--------------------------------------------------------------------
# Encryption (secrets and PII)
#--------------------------------------------------------------------
VAULT_ENABLED=false
ENCRYPTION_KEY=

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Mail — Namecheap Private Email (mail.privateemail.com), plain SMTP
#--------------------------------------------------------------------
SMTP_HOST=mail.privateemail.com
# 587 = STARTTLS (Namecheap's recommended default), 465 = implicit TLS — see config/mail.ts
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TrustSend

#--------------------------------------------------------------------
# Mobile Money (PawaPay)
#--------------------------------------------------------------------
PAWAPAY_ENV=sandbox
PAWAPAY_API_TOKEN=
# Optional, default 0 — no fee schedule encoded until commercial terms are set
MOBILE_MONEY_DEPOSIT_FEE_PERCENT=0
MOBILE_MONEY_PAYOUT_FEE_PERCENT=0

#--------------------------------------------------------------------
# Card Issuing (Payscribe)
#--------------------------------------------------------------------
PAYSCRIBE_ENV=sandbox
PAYSCRIBE_API_TOKEN=
# 64-char hex, generated once in Payscribe Dashboard > Settings > Security & API Keys
PAYSCRIBE_MERCHANT_HASH_KEY=
PAYSCRIBE_WEBHOOK_SECRET=
CARD_ISSUANCE_FEE_PERCENT=0
CARD_TOPUP_FEE_PERCENT=0