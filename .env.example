# Node
TZ=UTC
PORT=3330
HOST=localhost
NODE_ENV=development

# App
# production | sandbox — sandbox = public integration environment for business developers
# (auto-approved signup, no plan gating). Refuses to boot with a production PawaPay/Payscribe env.
APP_MODE=production
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# CORS — comma-separated exact origins allowed for credentialed cross-origin requests
# (admin panel, business dashboard). Required in production for cookie-based login to work.
# Example: CORS_ALLOWED_ORIGINS=https://admin.tumaplus.com,https://app.tumaplus.com
CORS_ALLOWED_ORIGINS=https://business.trustsend.africa,https://www.trustsend.africa,https://trustsend.africa

#--------------------------------------------------------------------
# Database (PostgreSQL)
#--------------------------------------------------------------------
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=

#--------------------------------------------------------------------
# Redis (BullMQ queue backend)
#--------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

#--------------------------------------------------------------------
# Encryption (secrets and PII)
#--------------------------------------------------------------------
VAULT_ENABLED=false
ENCRYPTION_KEY=

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Mail — Namecheap Private Email (mail.privateemail.com), plain SMTP
#--------------------------------------------------------------------
SMTP_HOST=mail.privateemail.com
# 587 = STARTTLS (Namecheap's recommended default), 465 = implicit TLS — see config/mail.ts
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Reemite

#--------------------------------------------------------------------
# Mobile Money (PawaPay)
#--------------------------------------------------------------------
PAWAPAY_ENV=sandbox
PAWAPAY_API_TOKEN=
# Optional, default 0 — no fee schedule encoded until commercial terms are set
MOBILE_MONEY_DEPOSIT_FEE_PERCENT=0
MOBILE_MONEY_PAYOUT_FEE_PERCENT=0

#--------------------------------------------------------------------
# Card Issuing (Payscribe)
#--------------------------------------------------------------------
PAYSCRIBE_ENV=sandbox
PAYSCRIBE_API_TOKEN=
# 64-char hex, generated once in Payscribe Dashboard > Settings > Security & API Keys
PAYSCRIBE_MERCHANT_HASH_KEY=
PAYSCRIBE_WEBHOOK_SECRET=
CARD_ISSUANCE_FEE_PERCENT=0
CARD_TOPUP_FEE_PERCENT=0

#--------------------------------------------------------------------
# Web3 / Crypto & Stablecoins (Alchemy)
#--------------------------------------------------------------------
ALCHEMY_API_KEY=
# One signing key per address-activity webhook, comma-separated. Empty = every webhook refused.
ALCHEMY_WEBHOOK_SIGNING_KEY=
# Notify API auth token, used to add each new deposit address to its network's webhook.
ALCHEMY_AUTH_TOKEN=
# Address-activity webhook per network. Only listed networks are offered for deposits.
ALCHEMY_WEBHOOK_IDS=polygon=wh_xxx,arbitrum=wh_yyy
# Treasury account-level xpub (BIP-44 m/44'/60'/0'). Never put an xprv or a mnemonic here:
# the mnemonic stays offline with treasury, which sweeps the deposit addresses.
CRYPTO_DEPOSIT_XPUB=
# Addresses shown to a user within this many days are re-scanned every 15 min for deposits
# whose webhook never arrived (Transfers API, billed per address). Default 7.
CRYPTO_RECONCILE_ACTIVE_DAYS=7
# Withdrawals (reviewed and sent by staff): networks offered, flat network fee per withdrawal
# in cents of the peg currency, and the smallest withdrawal in cents.
CRYPTO_PAYOUT_NETWORKS=polygon,bsc
CRYPTO_PAYOUT_NETWORK_FEES=polygon=0,bsc=0
CRYPTO_PAYOUT_MIN_AMOUNT=100
# Treasury address withdrawals are sent from (public address, never a key). The back office
# shows its balance per network; it is flagged when its fee coin drops below these amounts.
CRYPTO_TREASURY_ADDRESS=
CRYPTO_TREASURY_MIN_GAS=polygon=1,bsc=0.01
# Automatic withdrawals (phase 2). The hot wallet is a SEPARATE, small float the treasury tops up
# — never the treasury or the deposit phrase. Its private key is the only key on the server: set it
# in Coolify, never in a file that is committed. Unset = every withdrawal is reviewed by staff.
CRYPTO_HOT_WALLET_PRIVATE_KEY=
# Limits in cents: per withdrawal, per account over 24 h, all accounts over 24 h. Above → staff queue.
CRYPTO_AUTO_PAYOUT_MAX=20000
CRYPTO_AUTO_PAYOUT_USER_DAILY_MAX=50000
CRYPTO_AUTO_PAYOUT_DAILY_MAX=200000
# Team e-mails alerted when crypto money needs a human (comma-separated).
CRYPTO_ALERT_EMAILS=
# First withdrawal to a new address: `review` (staff, default) or `auto`. A PIN changed or a new
# phone in the last 24 h always sends the withdrawal to staff.
CRYPTO_AUTO_PAYOUT_NEW_ADDRESS=review
CRYPTO_DEPOSIT_FEE_PERCENT=0
CRYPTO_PAYOUT_FEE_PERCENT=0